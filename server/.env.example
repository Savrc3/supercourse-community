# 复制为 server/.env，仅在自建实例填写；不要提交真实配置。
SC_ENV=prod
SC_HOST=0.0.0.0
SC_PORT=8090
SC_DATA_DIR=/data
SC_ALLOW_REGISTRATION=true
SC_EXPOSE_HEALTH_DETAILS=false
SC_ALLOWED_ORIGINS=http://localhost:8080,capacitor://localhost
# 只在确定前面有可信反向代理时设 true（否则客户端可伪造 X-Forwarded-For 绕过限流）
SC_TRUST_PROXY_HEADERS=false
# 配对码有效期（秒，钳到 60~3600）与请求体上限（字节）
SC_PAIRING_CODE_TTL=300
SC_MAX_REQUEST_BYTES=20971520
# 应用内更新地址：指向公开发布安装包的直链（留空时界面提示「未配置」，不会给出失效按钮）
SC_ANDROID_UPDATE_URL=
SC_DESKTOP_UPDATE_URL=
SC_QQ_ENABLED=false
SC_ONEBOT_URL=http://127.0.0.1:3000
SC_ONEBOT_TOKEN=
SC_QQ_TARGET_USER_ID=0
