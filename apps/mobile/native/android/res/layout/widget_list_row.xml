<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="47dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="5dp"
    android:paddingEnd="4dp"
    android:paddingBottom="5dp">

    <TextView android:id="@+id/widget_item_time" android:layout_width="78dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:text="08:00–09:40" android:textColor="@color/widget_secondary" android:textSize="10sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="高等数学" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_item_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="A101" android:textColor="@color/widget_secondary" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
