<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="3dp" android:layout_height="16dp" android:background="@drawable/widget_bookmark" android:contentDescription="@null" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:fontFamily="serif" android:text="待办清单" android:textColor="@color/widget_ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10月08日" android:textColor="@color/widget_secondary" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="数据结构作业" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天 23:00" android:textColor="@color/widget_secondary" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_rule" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="实验报告" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="明天" android:textColor="@color/widget_secondary" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_rule" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="复习第三章" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10月12日" android:textColor="@color/widget_secondary" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_rule" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="整理课堂笔记" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10月13日" android:textColor="@color/widget_secondary" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_rule" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="准备小组讨论" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10月15日" android:textColor="@color/widget_secondary" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="五件待办排队，我先叹口气。" android:textColor="@color/widget_secondary" android:textSize="10sp" />
</LinearLayout>
